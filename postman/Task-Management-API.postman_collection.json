{
  "info": {
    "name": "Task Management API — all endpoints",
    "description": "Follow API_TEST_CASES.md in order. Register a manager and member first, save the returned IDs, then test project, task, comment, and admin actions. Admin login requires bootstrap admin credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "managerEmail",
      "value": "sam.manager@gmail.com"
    },
    {
      "key": "memberEmail",
      "value": "lee.member@gmail.com"
    },
    {
      "key": "adminEmail",
      "value": "admin.local@gmail.com"
    },
    {
      "key": "password",
      "value": "StrongPass123!"
    },
    {
      "key": "adminPassword",
      "value": "LocalAdminPass123!"
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberId",
      "value": "2"
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    },
    {
      "key": "cleanupTaskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Getting started",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "No login required. Expect 200 and status=ok."
          }
        },
        {
          "name": "Register manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sam Manager\",\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"project_manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Use an email that has not registered before. Expect 201."
          }
        },
        {
          "name": "Register member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lee Member\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Saves the returned member ID for task assignment. Expect 201."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('memberId', data.id);",
                  "pm.test('Saved memberId', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login manager",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{managerEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "description": "Uses the account email and saves the manager JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('managerToken', data.access_token);",
                  "pm.test('Login returned a token', function () { pm.expect(data.token_type).to.eql('bearer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login member",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{memberEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "description": "Uses the account email and saves the member JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('memberToken', data.access_token);",
                  "pm.test('Login returned a token', function () { pm.expect(data.token_type).to.eql('bearer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{adminEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Admin must first be created with BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', data.access_token);",
                  "pm.test('Login returned a token', function () { pm.expect(data.token_type).to.eql('bearer'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Refresh\",\n  \"description\": \"Update the public website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Manager/admin only. Saves projectId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('projectId', data.id);",
                  "pm.test('Saved projectId', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "List projects (page 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/projects?skip=0&limit=20"
          }
        },
        {
          "name": "Get project and task summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        },
        {
          "name": "List project tasks with filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/tasks?status=todo&priority=high"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task and assign member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": \"{{memberId}}\",\n  \"title\": \"Build the landing page\",\n  \"description\": \"Implement the approved design\",\n  \"priority\": \"high\",\n  \"due_date\": \"2026-11-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Set memberId to the ID returned by Register member. Expect 201."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('taskId', data.id);",
                  "pm.test('Saved taskId', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get task details (assignee)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Get my assigned tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/my/tasks"
          }
        },
        {
          "name": "Move status to in_progress",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run once in order: todo → in_progress → review → done. Assignee only."
          }
        },
        {
          "name": "Move status to review",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Move status to done",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update task details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build and review the landing page\",\n  \"description\": \"Use the approved design\",\n  \"priority\": \"critical\",\n  \"due_date\": \"2026-11-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Owning manager/admin only."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"I have started this task.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Any signed-in user can add a comment. Saves commentId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('commentId', data.id);",
                  "pm.test('Saved commentId', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "List task comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
          }
        },
        {
          "name": "Delete comment (author)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}",
            "description": "Only the author or admin can delete it. Expect 204."
          }
        }
      ]
    },
    {
      "name": "Admin (destructive; run last)",
      "item": [
        {
          "name": "Create a second task for delete test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": \"{{memberId}}\",\n  \"title\": \"Task to delete\",\n  \"description\": \"Created only to test task deletion\",\n  \"priority\": \"low\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('cleanupTaskId', data.id);",
                  "pm.test('Saved cleanupTaskId', function () { pm.expect(data.id).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/tasks/{{cleanupTaskId}}",
            "description": "Owning manager/admin only. The first task remains for the project cascade test."
          }
        },
        {
          "name": "Delete project and child tasks/comments",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/projects/{{projectId}}",
            "description": "Admin only. This permanently deletes the project and cascades to tasks and comments. Expect 204."
          }
        }
      ]
    }
  ]
}
